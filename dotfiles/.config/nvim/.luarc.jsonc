      "$HOME/.local/share/nvim/site/pack/core/opt/fzf-lua/lua/",
      "$HOME/.local/share/nvim/site/pack/core/opt/markview.nvim/lua",
      "$HOME/.local/share/nvim/site/pack/core/opt/mason.nvim/lua",
      "$HOME/.local/share/nvim/site/pack/core/opt/mini.nvim/lua",
      "$HOME/.local/share/nvim/site/pack/core/opt/nvim-colorizer.lua/lua",
      "$HOME/.local/share/nvim/site/pack/core/opt/nvim-dap/lua",
      "$HOME/.local/share/nvim/site/pack/core/opt/nvim-dap-view/lua",
      "$HOME/.local/share/nvim/site/pack/core/opt/nvim-treesitter/lua",
      "$HOME/.local/share/nvim/site/pack/core/opt/nvim-treesitter-context/lua",
      "$HOME/.local/share/nvim/site/pack/core/opt/yazi.nvim/lua",
    ],
